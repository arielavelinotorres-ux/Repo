<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] as string ?? "HomeClass") — Entorno Académico HomeClass</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <script>try { var t = localStorage.getItem('homeclass-tema'); if (t) document.documentElement.setAttribute('data-bs-theme', t); } catch (e) { }</script>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-rol="admin">
    @RenderBody()
    <partial name="_Toasts" />
    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
