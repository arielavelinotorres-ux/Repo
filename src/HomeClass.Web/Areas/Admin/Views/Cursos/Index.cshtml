@model IReadOnlyList<CursoResumenDto>
@{ ViewData["Title"] = "Cursos"; }
<div class="page-head">
    <div><h1>Cursos</h1><p>Todos los cursos de la institución, con su docente y su rendimiento.</p></div>
    <div class="actions"><a asp-action="Crear" class="btn btn-primary"><i class="bi bi-journal-plus"></i> Nuevo curso</a></div>
</div>

<div class="panel" data-filtrable>
    <div class="filtros">
        <div class="buscador">
            <i class="bi bi-search"></i>
            <input type="search" class="form-control" data-buscar placeholder="Buscar curso, código o docente" aria-label="Buscar curso" />
        </div>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty"><i class="bi bi-journal-bookmark"></i><strong>Aún no hay cursos</strong>Crea el primero y asígnale un docente.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="tabla">
                <thead><tr><th data-sort="text">Curso</th><th data-sort="text">Docente</th><th class="num" data-sort="num">Estudiantes</th><th class="num" data-sort="num">Evaluaciones</th><th class="num" data-sort="num">Promedio</th><th class="num" data-sort="num">Asistencia</th><th>Estado</th><th class="num">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr data-fila data-texto="@c.Nombre @c.Codigo @c.Docente">
                            <td><strong>@c.Nombre</strong><small class="d-block muted">@c.Codigo</small></td>
                            <td>@c.Docente</td>
                            <td class="num">@c.Estudiantes</td>
                            <td class="num">@c.Evaluaciones</td>
                            <td class="num" data-valor="@(c.Promedio ?? -1)"><span class="nota @Ui.ClaseNota(c.Promedio)">@Ui.Nota(c.Promedio)</span></td>
                            <td class="num" data-valor="@(c.Asistencia ?? -1)"><span class="nota @Ui.ClasePct(c.Asistencia)">@Ui.Pct(c.Asistencia)</span></td>
                            <td><span class="estado-dot @(c.Activo ? "" : "off")">@(c.Activo ? "Activo" : "Inactivo")</span></td>
                            <td class="num">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Matricula" asp-route-id="@c.Id" class="icon-btn" title="Matrícula" aria-label="Matrícula de @c.Nombre"><i class="bi bi-person-plus"></i></a>
                                    <a asp-action="Editar" asp-route-id="@c.Id" class="icon-btn" title="Editar" aria-label="Editar @c.Nombre"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Eliminar" asp-route-id="@c.Id" method="post" class="d-inline"
                                          data-confirm="Se eliminará @c.Nombre con sus @c.Evaluaciones evaluaciones, notas y asistencias. Esta acción no se puede deshacer."
                                          data-confirm-titulo="Eliminar curso" data-confirm-boton="Eliminar">
                                        <button type="submit" class="icon-btn" title="Eliminar" aria-label="Eliminar @c.Nombre"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="empty" data-vacio hidden><i class="bi bi-search"></i><strong>No hay resultados</strong>Prueba con otra búsqueda.</div>
    }
</div>
