@model DocenteDashboardDto
@{
    ViewData["Title"] = "Mi resumen";
    var r = Model.Riesgo;
    var primerNombre = Model.Nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
    var chartCursos = Ui.Json(new { type = "bar", max = 100, labels = Model.Cursos.Select(c => c.Codigo), datasets = new[] { new { label = "Promedio", data = Model.Cursos.Select(c => c.Promedio) } } });
    var chartRiesgo = Ui.Json(new { type = "doughnut", labels = Ui.EtiquetasRiesgo, datasets = new[] { new { data = Ui.ValoresRiesgo(r), colors = Ui.ColoresRiesgo } } });
    var chartTendencia = Ui.Json(new { type = "line", max = 100, labels = Model.TendenciaEvaluaciones.Etiquetas, datasets = new[] { new { label = "Promedio de la clase", data = Model.TendenciaEvaluaciones.Valores } } });
}
<div class="page-head">
    <div>
        <h1>Hola, @primerNombre</h1>
        <p>@(string.IsNullOrWhiteSpace(Model.Especialidad) ? "Así van tus cursos hoy." : Model.Especialidad + ". Así van tus cursos hoy.")</p>
    </div>
    <div class="actions">
        <a asp-controller="Cursos" asp-action="Crear" class="btn btn-primary"><i class="bi bi-journal-plus"></i> Nuevo curso</a>
    </div>
</div>

@if (Model.TotalCursos == 0)
{
    <div class="panel"><div class="empty">
        <i class="bi bi-journal-bookmark"></i>
        <strong>Todavía no tienes cursos</strong>
        Crea tu primer curso, matricula estudiantes y empieza a calificar.
        <div class="mt-3"><a asp-controller="Cursos" asp-action="Crear" class="btn btn-primary">Crear mi primer curso</a></div>
    </div></div>
    return;
}

<div class="stat-strip">
    <partial name="_Stat" model='new StatVm("Cursos", Model.TotalCursos.ToString(), "bi-journal-bookmark")' />
    <partial name="_Stat" model='new StatVm("Estudiantes", Model.TotalEstudiantes.ToString(), "bi-people")' />
    <partial name="_Stat" model='new StatVm("Promedio general", Ui.Nota(Model.PromedioGeneral), "bi-graph-up", Ui.ClaseNota(Model.PromedioGeneral))' />
    <partial name="_Stat" model='new StatVm("Asistencia", Ui.Pct(Model.AsistenciaGeneral), "bi-calendar-check", Ui.ClasePct(Model.AsistenciaGeneral))' />
    <partial name="_Stat" model='new StatVm("Evaluaciones", Model.TotalEvaluaciones.ToString(), "bi-journal-check")' />
    <partial name="_Stat" model='new StatVm("Riesgo alto", r.Alto.ToString(), "bi-exclamation-octagon", r.Alto > 0 ? "mal" : "bien", r.Moderado + " en riesgo moderado")' />
</div>

<div class="grid cols-3">
    <section class="panel">
        <div class="panel-h"><h2>Promedio por curso</h2></div>
        <div class="panel-b"><div class="chart-box"><canvas data-chart="@chartCursos" role="img" aria-label="Promedio por curso"></canvas></div></div>
    </section>
    <section class="panel">
        <div class="panel-h"><h2>Tus estudiantes por nivel</h2><a asp-controller="Riesgo" asp-action="Index" class="small">Ver detalle</a></div>
        <div class="panel-b"><div class="chart-box"><canvas data-chart="@chartRiesgo" role="img" aria-label="Estudiantes por nivel de riesgo"></canvas></div></div>
    </section>
    <section class="panel">
        <div class="panel-h"><h2>Evolución de la clase</h2></div>
        <div class="panel-b">
            @if (Model.TendenciaEvaluaciones.Etiquetas.Count == 0)
            {
                <div class="empty"><i class="bi bi-graph-up"></i>Aparecerá cuando registres notas.</div>
            }
            else
            {
                <div class="chart-box"><canvas data-chart="@chartTendencia" role="img" aria-label="Promedio de la clase por evaluación"></canvas></div>
            }
        </div>
    </section>
</div>

<div class="grid cols-wide">
    <section class="panel">
        <div class="panel-h"><h2>Quién necesita atención</h2><a asp-controller="Riesgo" asp-action="Index" class="small">Ver todos</a></div>
        @if (Model.AlumnosAtencion.Count == 0)
        {
            <div class="empty"><i class="bi bi-emoji-smile"></i><strong>Todos van bien</strong>Nadie está en riesgo por ahora.</div>
        }
        else
        {
            <ul class="lista-simple">
                @foreach (var a in Model.AlumnosAtencion)
                {
                    <li>
                        <div class="celda-persona">
                            <span class="avatar">@Ui.Iniciales(a.Nombre)</span>
                            <div><strong>@a.Nombre</strong><small>@(a.Sugerencias.FirstOrDefault()?.Titulo ?? a.Cursos)</small></div>
                        </div>
                        <div class="text-end">
                            <partial name="_Nivel" model="a.Nivel" />
                            <small>Promedio @Ui.Nota(a.Promedio), asistencia @Ui.Pct(a.Asistencia)</small>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
    <section class="panel">
        <div class="panel-h"><h2>Próximas evaluaciones</h2></div>
        @if (Model.Proximas.Count == 0)
        {
            <div class="empty"><i class="bi bi-calendar-event"></i>No hay evaluaciones programadas.</div>
        }
        else
        {
            <ul class="lista-simple">
                @foreach (var e in Model.Proximas)
                {
                    <li>
                        <div class="d-flex gap-3 align-items-center">
                            <div class="fecha-bloque"><b>@e.Fecha.Day</b><span>@e.Fecha.ToString("MMM")</span></div>
                            <div><strong>@e.Titulo</strong><small>@e.Curso, @e.Tipo.Texto(), @e.Ponderacion.ToString("0.#")%</small></div>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
</div>

<h2 class="h5 fw-bold mb-3">Mis cursos</h2>
<div class="cursos-grid">
    @foreach (var c in Model.Cursos)
    {
        <partial name="_CursoCard" model="c" />
    }
</div>
