@model IReadOnlyList<CursoResumenDto>
@{ ViewData["Title"] = "Mis cursos"; }
<div class="page-head">
    <div><h1>Mis cursos</h1><p>Los cursos que impartes, con su promedio y asistencia.</p></div>
    <div class="actions"><a asp-action="Crear" class="btn btn-primary"><i class="bi bi-journal-plus"></i> Nuevo curso</a></div>
</div>
@if (Model.Count == 0)
{
    <div class="panel"><div class="empty">
        <i class="bi bi-journal-bookmark"></i>
        <strong>Todavía no tienes cursos</strong>
        Crea uno, matricula a tus estudiantes y empieza a calificar.
        <div class="mt-3"><a asp-action="Crear" class="btn btn-primary">Crear mi primer curso</a></div>
    </div></div>
}
else
{
    <div class="cursos-grid">
        @foreach (var c in Model)
        {
            <partial name="_CursoCard" model="c" />
        }
    </div>
}
