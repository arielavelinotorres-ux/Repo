@model LibroCalificacionesDto
@{
    ViewData["Title"] = "Calificaciones";
    var urlNota = Url.Action("GuardarNota");
    var restante = 100 - Model.SumaPonderacion;
}
<partial name="_CursoTabs" model='new CursoCabeceraVm(Model.CursoId, Model.Codigo, Model.Nombre, "notas")' />

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div style="min-width:240px;flex:1;max-width:420px">
        <div class="d-flex justify-content-between small fw-semibold mb-1">
            <span>Ponderación asignada</span><span>@Model.SumaPonderacion.ToString("0.#")% de 100%</span>
        </div>
        <div class="barra"><span class="@(Model.SumaPonderacion == 100 ? "bien" : "medio")" style="width:@((int)Math.Min(100, Model.SumaPonderacion))%"></span></div>
        @if (restante > 0)
        {
            <div class="small muted mt-1">Faltan @restante.ToString("0.#")% por asignar para completar el curso.</div>
        }
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#evaluacionModal"><i class="bi bi-plus-lg"></i> Nueva evaluación</button>
</div>

@if (Model.Filas.Count == 0)
{
    <div class="panel"><div class="empty"><i class="bi bi-people"></i><strong>Aún no hay estudiantes en este curso</strong>Matricúlalos para poder calificar.
        <div class="mt-3"><a asp-action="Matricula" asp-route-id="@Model.CursoId" class="btn btn-primary">Matricular estudiantes</a></div></div></div>
}
else if (Model.Evaluaciones.Count == 0)
{
    <div class="panel"><div class="empty"><i class="bi bi-journal-plus"></i><strong>Aún no hay evaluaciones</strong>Agrega la primera (un quiz, una tarea, un parcial) y aparecerá aquí como columna.</div></div>
}
else
{
    <div class="panel">
        <div class="libro-wrap">
            <table class="libro">
                <thead>
                    <tr>
                        <th class="sticky-col">Estudiante</th>
                        @foreach (var ev in Model.Evaluaciones)
                        {
                            <th class="col-eval @(ev.Fecha.Date > DateTime.Today ? "futura" : "")">
                                <div class="d-flex justify-content-center align-items-center gap-1">
                                    <button type="button" class="btn btn-link p-0 fw-bold text-decoration-none" style="color:var(--ink)" title="Editar evaluación"
                                            data-bs-toggle="modal" data-bs-target="#evaluacionModal"
                                            data-eval-id="@ev.Id" data-titulo="@ev.Titulo" data-tipo="@((int)ev.Tipo)" data-peso="@ev.Ponderacion.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" data-fecha="@Ui.InputFecha(ev.Fecha)">@ev.Titulo</button>
                                    <form asp-action="EliminarEvaluacion" asp-route-id="@ev.Id" asp-route-cursoId="@Model.CursoId" method="post" class="d-inline"
                                          data-confirm="Se eliminará «@ev.Titulo» y las notas que ya registraste en ella."
                                          data-confirm-titulo="Eliminar evaluación" data-confirm-boton="Eliminar">
                                        <button type="submit" class="btn btn-link p-0 muted" aria-label="Eliminar @ev.Titulo"><i class="bi bi-x-lg"></i></button>
                                    </form>
                                </div>
                                <small>@ev.Tipo.Texto(), @ev.Ponderacion.ToString("0.#")%</small>
                                <small>@Ui.FechaCorta(ev.Fecha)</small>
                                <small>Clase: <span id="grupo-@ev.Id">@Ui.Nota(ev.PromedioGrupo)</span></small>
                            </th>
                        }
                        <th class="prom">Promedio</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in Model.Filas)
                    {
                        <tr>
                            <td class="sticky-col"><strong>@fila.Nombre</strong><small class="d-block muted">@fila.Carnet</small></td>
                            @foreach (var ev in Model.Evaluaciones)
                            {
                                var nota = fila.Notas.TryGetValue(ev.Id, out var valor) ? (decimal?)valor : null;
                                <td class="col-eval @(ev.Fecha.Date > DateTime.Today ? "futura" : "")">
                                    <input class="nota-input" inputmode="decimal" autocomplete="off" value="@(nota.HasValue ? nota.Value.ToString("0.##") : "")"
                                           data-url="@urlNota" data-eval="@ev.Id" data-est="@fila.EstudianteId"
                                           aria-label="Nota de @fila.Nombre en @ev.Titulo" />
                                </td>
                            }
                            <td id="prom-@fila.EstudianteId" class="prom nota @Ui.ClaseNota(fila.Promedio)">@Ui.Nota(fila.Promedio)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-3 py-2 small muted border-top"><i class="bi bi-lightning-charge"></i> Escribe una nota y presiona Enter: se guarda sola y baja a la siguiente celda. Deja la celda vacía para borrarla.</div>
    </div>
}

<div class="modal fade" id="evaluacionModal" tabindex="-1" aria-labelledby="evalTituloModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" method="post" asp-action="GuardarEvaluacion">
            <input type="hidden" name="Id" id="ev-id" />
            <input type="hidden" name="CursoId" value="@Model.CursoId" />
            <div class="modal-header">
                <h2 class="modal-title fs-5 fw-bold" id="evalTituloModal">Nueva evaluación</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12"><label class="form-label" for="ev-titulo">Título</label><input class="form-control" id="ev-titulo" name="Titulo" maxlength="120" required placeholder="Parcial 2" /></div>
                    <div class="col-sm-6">
                        <label class="form-label" for="ev-tipo">Tipo</label>
                        <select class="form-select" id="ev-tipo" name="Tipo">
                            @foreach (var t in Enum.GetValues<TipoEvaluacion>())
                            {
                                <option value="@((int)t)">@t.Texto()</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6"><label class="form-label" for="ev-peso">Ponderación (%)</label><input class="form-control" id="ev-peso" name="Ponderacion" type="number" min="1" max="100" step="0.5" required /></div>
                    <div class="col-12"><label class="form-label" for="ev-fecha">Fecha</label><input class="form-control" id="ev-fecha" name="Fecha" type="date" required />
                        <div class="form-text">Si la fecha es futura, aparece como próxima evaluación en el panel de los estudiantes.</div></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar evaluación</button>
            </div>
        </form>
    </div>
</div>
